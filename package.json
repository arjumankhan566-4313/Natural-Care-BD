{
  "name": "natural-care-bd",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:css": "tailwindcss -i ./src/styles/tailwind-input.css -o ./public/static/tailwind.css --minify",
    "build": "npm run build:css && vite build",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test --experimental-strip-types tests/*.test.mjs",
    "preview": "npm run build && wrangler dev --test-scheduled",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply natural-care-bd-production --local",
    "db:migrate:remote": "wrangler d1 migrations apply natural-care-bd-production --remote",
    "db:seed:local": "wrangler d1 execute natural-care-bd-production --local --file=./seed.sql",
    "tail": "wrangler tail",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260829.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
